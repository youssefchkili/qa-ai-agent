# Per-run artifacts: clones, raw tool JSON, screenshots, reports. Never committed.
workspace/

# Vendored scanner binaries and offline rule/vuln databases (fetched by scripts/).
vendor/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local secrets / overrides
.env

# The evaluation answer sheet must never be published: a public answer sheet
# lets the agent be tuned against it. Results are regenerated by the harness.
eval/answer_sheet.json
eval/results/

# Node (Lighthouse is invoked through npx)
node_modules/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
eval/target_app/
